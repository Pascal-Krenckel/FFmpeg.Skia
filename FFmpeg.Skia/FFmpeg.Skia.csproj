<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>netstandard2.1</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<AllowUnsafeBlocks>True</AllowUnsafeBlocks>
		<GeneratePackageOnBuild Condition=" $(Configuration) == 'Release' ">true</GeneratePackageOnBuild>
		<GenerateDocumentationFile Condition=" $(Configuration) == 'Release' ">True</GenerateDocumentationFile>
		<PackageId>FFmpegDotNet.Skia</PackageId>
		<Title>FFmpeg.Skia</Title>
		<Authors>Pascal Krenckel</Authors>
		<Description>
			Provides SkiaSharp integration for the FFmpeg .NET wrapper.
			Enables converting FFmpeg AVFrames to SKImage or SKBitmap, and includes high-level classes (FFCodec2Skia, SKVideo) for decoding and rendering videos or images with Skia.
		</Description>
		<Copyright>Copyright (c) 2025 Pascal Krenckel. All rights reserved.</Copyright>
		<PackageProjectUrl>https://github.com/Pascal-Krenckel/FFmpeg.Skia</PackageProjectUrl>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<RepositoryUrl>https://github.com/Pascal-Krenckel/FFmpeg.Skia</RepositoryUrl>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<IncludeSymbols>True</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<RepositoryType>git</RepositoryType>
		<PackageTags>ffmpeg; skia</PackageTags>
		<PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
		<!-- FFmpegMajor.Major.Minor.Patch, like FFmpegDotNet: 8.2.4.0 is built for FFmpeg 8, 9.2.4.0 for FFmpeg 9 -->
		<Version>$(FFmpegMajor).2.4.0</Version>
		<DefineConstants Condition="'$(FFmpegMajor)' == '9'">$(DefineConstants);FFMPEG9</DefineConstants>
		<PackageReleaseNotes>
			=== 2.4.0 ===
			Builds for FFmpeg 8 (FFmpegDotNet 8.x, package version 8.2.4.0) and FFmpeg 9 (FFmpegDotNet 9.x, package version 9.2.4.0) from the same sources.
			Color conversion uses FFmpeg's dynamic scaler with both versions and honours the frames' color properties: YUV matrix (BT.601/BT.709/BT.2020) and range (limited/full) in both directions; before, the YUV matrix and the full range of yuv420p frames were ignored (always BT.601 limited, except yuvj formats).
			HDR (PQ, HLG) is tone mapped and wide gamuts (BT.2020, P3) are mapped to BT.709 when converting to Skia (SDR), and the other way round when converting into frames tagged that way.
			YUV frames written from Skia without matrix or range are tagged BT.601 / limited range (what is written), so encoders signal it.
			Frames marked interlaced are converted as progressive images (no lines are lost).
			The extension methods (ToSKBitmap, CopyTo, AsSKImage, DrawFrame, ...) reuse their conversion setup: converting HDR frames took seconds per call.
			Bitmaps allocated for frames (CopyTo into an empty bitmap, SKAnimatedImage) use 8 bit color types; 10 bit video got RgbaF16.
			SKAnimatedImage uses three buffers: Frame can be drawn from a render loop, it is not written until the frame after the next one is decoded.
			Added Rotation (display matrix, e.g. phone videos), SampleAspectRatio and DisplaySize to FFCodec2Skia, SKVideo and SKAnimatedImage, AVStream/AVFrame.GetDisplayRotation, AVStream.GetSampleAspectRatio and SKCanvas.DrawRotated.
			Videos with non-square pixels (e.g. DVD, broadcast) are decoded with square pixels by default (FFCodec2Skia, SKVideo, SKAnimatedImage), e.g. 720x480 with 32:27 as 853x480.
			BugFix: copying frames whose rows are padded (most decoded frames) threw ArgumentOutOfRangeException (ToSKBitmap, ToSKImage, CopyTo, FFCodec2Skia, SKAnimatedImage).
			BugFix: SKImage/SKBitmap.ToAVFrame and CopyTo ignored the row bytes of the image: skewed images and a heap overflow for images with padded rows (e.g. from AsSKImage).
			BugFix: FFCodec2Skia reused a scaler for bitmaps of another size: heap overflow.
			BugFix: cropped frames: AsSKBitmap/AsSKImage/Reference used a wrong row offset, CopyTo and FFCodec2Skia ignored the crop.
			BugFix: SKBitmap.Reference wrote into the buffer of the previously referenced frame.
			BugFix: AsSKBitmap/AsSKImage and FFCodec2Skia.Info used premultiplied alpha; FFmpeg's alpha is straight. Premultiplied Skia images are now converted.
			BugFix: SKImage.ToAVFrame threw NullReferenceException for lazily decoded images.
			BugFix: ToSKImage leaked the uncropped image.
			BugFix: FFCodec2Skia.Create leaked the media source when the media has no video stream (now ArgumentException).
			FFCodec2Skia.Seek(TimeSpan) now returns the frame visible at the requested time (it returned the key frame before it); Seek(long) uses the frame rate instead of FFmpeg's frame seeking, which most formats ignore.
			FFCodec2Skia.Duration falls back to the media duration if the stream has none. NextImage throws on decoding errors instead of returning false.
			SKVideo: Dispose after Stop threw; Dispose freed the frames while the decoding thread or a handler used them; Restart while playing was not synchronized and lost the timing; seeking in an Ended handler now continues playback (e.g. looping). Added the Faulted event.
			SKAnimatedImage: frames were shown for the duration of the next frame; Stop allowed a second loop or manual decoding while the first loop was still running; Dispose during an operation could be undone by the operation; the AVFrame (and in DisposeAsync a bitmap) leaked; looping a still image busy-looped; Dispose from a ReadyToRender handler is safe.
			=== 2.3.0 ===
			Added SKAnimatedImage - a class that allows for both automatic and manual decoding auf image/video data.
			=== 2.2.0 ===
			AVFrame.CopyTo(SKBitmap) allows now empty bitmaps.
			SKBitmap.Reference(AVFrame). Same as AVFrame.AsSKBitmap(), just with an existing SKBitmap.
			=== 2.1.0 ===
			Added CopyTo-Extension that copies the content of SKBitmap/SKImage into an existing AVFrame
			BugFix: Removed blocking scheduler from SKVideo
			=== 2.0.0 ===
			Some smaller BugFixes
			Added xml docu into the package.
			Some functions got renamed.
	    </PackageReleaseNotes>
		<GenerateDocumentationFile>True</GenerateDocumentationFile>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\LICENSE.txt">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="..\README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Condition="'$(FFmpegMajor)' == '8'" Include="FFmpegDotNet" Version="[8.1.2.15,9)" />
		<PackageReference Condition="'$(FFmpegMajor)' == '9'" Include="FFmpegDotNet" Version="[9.9.4,10)" />
		<PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.400">
		  <PrivateAssets>all</PrivateAssets>
		  <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="SkiaSharp" Version="4.151.1" />
	</ItemGroup>

	<ItemGroup>
		<Using Include="SkiaSharp" />
	</ItemGroup>

	<Target Name="CheckFFmpegMajor" BeforeTargets="Restore;CollectPackageReferences;Build">
		<Error Condition="'$(FFmpegMajor)' != '8' And '$(FFmpegMajor)' != '9'" Text="FFmpegMajor must be 8 or 9 (is '$(FFmpegMajor)')." />
	</Target>

</Project>

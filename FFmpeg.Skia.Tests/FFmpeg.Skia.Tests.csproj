<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0;net10.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<IsPackable>false</IsPackable>
		<IsTestProject>true</IsTestProject>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="coverlet.collector" Version="10.1.1">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<!-- FFmpeg binaries matching the FFmpegDotNet version FFmpeg.Skia is built against (see Directory.Build.props) -->
		<PackageReference Condition="'$(FFmpegMajor)' == '8'" Include="FFmpegDotNet.bin.winx64" Version="8.1.2.4" />
		<PackageReference Condition="'$(FFmpegMajor)' == '9'" Include="FFmpegDotNet.bin.winx64" Version="9.0.2.1" />
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
		<PackageReference Include="MSTest.TestAdapter" Version="4.5.3" />
		<PackageReference Include="MSTest.TestFramework" Version="4.5.3" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\FFmpeg.Skia\FFmpeg.Skia.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
		<Using Include="SkiaSharp" />
		<Using Include="FFmpeg.Images" />
		<Using Include="FFmpeg.Utils" />
	</ItemGroup>

	<ItemGroup>
		<!-- Every file in Test-Files is copied next to the test assembly (see TestFiles). -->
		<None Update="Test-Files\**\*">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

</Project>

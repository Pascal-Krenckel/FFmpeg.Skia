<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>
		<SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Condition="'$(FFmpegMajor)' == '8'" Include="FFmpegDotNet.bin.winx64" Version="8.1.2.4" />
		<PackageReference Condition="'$(FFmpegMajor)' == '9'" Include="FFmpegDotNet.bin.winx64" Version="9.0.2.1" />
		<PackageReference Include="SkiaSharp.Views.WPF" Version="4.150.1" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\FFmpeg.Skia\FFmpeg.Skia.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Update="mp4-example-video-download-full-hd-1920x1080.1min.mp4">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

</Project>
